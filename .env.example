# Domain
# Set to your deployment domain in staging/production.
DOMAIN=localhost
# DOMAIN=localhost.tiangolo.com

# Frontend URL used by backend for links (emails, redirects)
FRONTEND_HOST=http://localhost:3000

# Environment: local | staging | production
ENVIRONMENT=local

# Project metadata
PROJECT_NAME=mnsAI
STACK_NAME=full-stack-fastapi-project

# Backend CORS origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000,https://localhost,https://localhost:3000,http://localhost.tiangolo.com

# Security / bootstrap user
SECRET_KEY=replace-with-a-random-secret-key
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres (external DB)
# POSTGRES_SERVER=host.docker.internal
POSTGRES_SERVER=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=your_database
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=replace-with-db-password

# Optional monitoring
SENTRY_DSN=

# Docker image names
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# OpenAI
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_DEPLOYMENT_ID=gpt-4o

# App limits
MAX_EXTR_COUNT=70
MAX_CONCURRENT_PDF_CONVERSION=4
BATCH_SIZE=100

# Visual document extractor (independent from the legacy GPT OCR endpoints)
DOCUMENT_EXTRACTOR_MAX_UPLOAD_BYTES=26214400
DOCUMENT_EXTRACTOR_MAX_PAGES=100
DOCUMENT_EXTRACTOR_MAX_RENDERED_PIXELS=40000000
DOCUMENT_EXTRACTOR_PARSER_TIMEOUT_SECONDS=60
DOCUMENT_EXTRACTOR_TRANSIENT_RETRIES=1
DOCUMENT_EXTRACTOR_ALTERNATE_ATTEMPTS=2
DOCUMENT_EXTRACTOR_VISION_ATTEMPTS=3
DOCUMENT_EXTRACTOR_VISION_ENABLED=False
DOCUMENT_EXTRACTOR_MINIMUM_CONFIDENCE=0.80
DOCUMENT_EXTRACTOR_MISTRAL_ENABLED=False
DOCUMENT_EXTRACTOR_MISTRAL_MODEL=mistral-ocr-4-0
DOCUMENT_EXTRACTOR_MISTRAL_TIMEOUT_SECONDS=60
DOCUMENT_EXTRACTOR_OPENAI_VISION_ENABLED=False
DOCUMENT_EXTRACTOR_OPENAI_DEFAULT_MODEL=gpt-5.6-terra
DOCUMENT_EXTRACTOR_OPENAI_ESCALATION_MODEL=gpt-5.6-sol
DOCUMENT_EXTRACTOR_OPENAI_TIMEOUT_SECONDS=60
MISTRAL_API_KEY=
DOCUMENT_EXTRACTOR_MAX_PARSER_PROCESSES=2
DOCUMENT_EXTRACTOR_PARSER_CPU_SECONDS=60
DOCUMENT_EXTRACTOR_PARSER_MEMORY_MB=2048
DOCUMENT_EXTRACTOR_PREVIEW_DPI=144
DOCUMENT_EXTRACTOR_OFFICE_BINARY=soffice
DOCUMENT_EXTRACTOR_OFFICE_TIMEOUT_SECONDS=90
DOCUMENT_EXTRACTOR_USE_DURABLE_STORE=True

# Optional JSON worker executables. Each receives a normalized PageInput JSON
# document on stdin and must return AdapterResult JSON on stdout.
VISUAL_EXTRACTOR_DOCLING_WORKER=
VISUAL_EXTRACTOR_PADDLEOCR_WORKER=
VISUAL_EXTRACTOR_PADDLEOCR_VL_WORKER=
VISUAL_EXTRACTOR_MINERU_WORKER=
VISUAL_EXTRACTOR_MARKER_WORKER=

# OAuth2 Social Login (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: used by playwright service in docker-compose.override.yml
CI=

# External micro-frontends
# Frontend: set in Vercel environment variables
# NEXT_PUBLIC_COURSE_SEARCH_URL=https://your-course-search-app.vercel.app
# NEXT_PUBLIC_ATS_RESUME_MATCHER_URL=https://your-ats-resume-matcher.vercel.app

NEXT_PUBLIC_COURSE_SEARCH_URL=https://localhost:3001
NEXT_PUBLIC_ATS_RESUME_MATCHER_URL=https://localhost:3002
